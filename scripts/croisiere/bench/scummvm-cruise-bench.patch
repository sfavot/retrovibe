+// Banc : SKY_VIRTUAL_TIME=1 : horloge virtuelle, qui n'avance que par delayMillis (sans attendre) ; les tours, fondus, sequences et attentes
+// du jeu prennent leur duree nominale sans temps reel (comme le portage, qui compte ses ticks de 20 ms).
+static bool benchVirtualTime() {
+	static int v = -1;
+	if (v < 0)
+		v = (getenv("SKY_VIRTUAL_TIME") || getenv("CRUISE_VIRTUAL_TIME")) ? 1 : 0;
+	return v == 1;
+}
+static volatile uint32 benchNow = 0;
+
+// Banc (cruise) : minuterie de 50 Hz (periode 20 ms) pilotee par l'horloge virtuelle, dans le fil principal, a la place du callback OPL du mixeur
+// (qui tourne sur le fil audio en temps reel). Le moteur y enregistre son callback ; il est appele chaque fois que l'horloge franchit un multiple de 20 ms.
+void (*g_benchTimer50)() = nullptr;
+static uint32 benchNextTick = 20;
+static bool benchInTick = false;
+
 uint32 OSystem_SDL::getMillis(bool skipRecord) {
-	uint32 millis = SDL_GetTicks();
+	uint32 millis = benchVirtualTime() ? benchNow : SDL_GetTicks();
 
 #ifdef ENABLE_EVENTRECORDER
 	g_eventRec.processMillis(millis, skipRecord);
@@ -887,6 +903,21 @@ uint32 OSystem_SDL::getMillis(bool skipRecord) {
 }
 
 void OSystem_SDL::delayMillis(uint msecs) {
+	if (benchVirtualTime()) {
+		benchNow += msecs ? msecs : 1;
+		static void (*benchHookSeen)() = nullptr;
+		if (g_benchTimer50 != benchHookSeen) {	// callback (re)enregistre : premiere echeance au prochain multiple de 20 ms, sans rattrapage
+			benchHookSeen = g_benchTimer50;
+			benchNextTick = (benchNow / 20 + 1) * 20;
+		}
+		while (g_benchTimer50 && !benchInTick && benchNow >= benchNextTick) {
+			benchNextTick += 20;
+			benchInTick = true;
+			g_benchTimer50();
+			benchInTick = false;
+		}
+		return;
+	}
 #ifdef ENABLE_EVENTRECORDER
 	if (g_eventRec.processDelayMillis())
 #endif
