+static uint32 crc32(const uint8 *p, uint n) {
+	static uint32 table[256];
+	static bool ready = false;
+	if (!ready) {
+		for (uint32 i = 0; i < 256; i++) {
+			uint32 c = i;
+			for (int k = 0; k < 8; k++)
+				c = (c & 1) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+			table[i] = c;
+		}
+		ready = true;
+	}
+	uint32 c = 0xFFFFFFFFu;
+	for (uint i = 0; i < n; i++)
+		c = table[(c ^ p[i]) & 0xFF] ^ (c >> 8);
+	return c ^ 0xFFFFFFFFu;
+}
