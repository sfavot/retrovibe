+// Banc : GOB_VIRTUAL_AUDIO=1 (avec SKY_VIRTUAL_TIME=1) : le melangeur n'est plus tire par le peripherique audio (suspendu) mais par
+// l'horloge virtuelle : chaque delayMillis melange (et jette) les echantillons de la duree ecoulee. Les sons finissent donc a leur duree
+// nominale en temps virtuel (necessaire a gob : o1_waitEndPlay attend la fin des samples).
+static void benchMixVirtual(MixerManager *mm, uint32 nowMs) {
+	static int v = -1;
+	if (v < 0)
+		v = getenv("GOB_VIRTUAL_AUDIO") ? 1 : 0;
+	if (v != 1 || !mm || !mm->getMixer())
+		return;
+	static bool suspended = false;
+	static uint64 framesDone = 0;
+	static uint32 startMs = 0;
+	Audio::MixerImpl *mixer = (Audio::MixerImpl *)mm->getMixer();
+	if (!suspended) {
+		mm->suspendAudio();
+		suspended = true;
+		startMs = nowMs;
+	}
+	const uint rate = mixer->getOutputRate();
+	const uint bytesPerFrame = 2 * (mixer->getOutputStereo() ? 2 : 1);
+	const uint64 target = (uint64)(nowMs - startMs) * rate / 1000;
+	static byte buf[4096 * 4];
+	while (framesDone < target) {
+		uint64 n = MIN<uint64>(target - framesDone, sizeof(buf) / bytesPerFrame);
+		mixer->mixCallback(buf, (uint)(n * bytesPerFrame));
+		framesDone += n;
+	}
+}
