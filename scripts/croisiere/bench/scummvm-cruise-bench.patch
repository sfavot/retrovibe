+			(int)a->x, (int)a->y, (int)a->x_dest, (int)a->y_dest, (int)a->phase, (int)a->counter, (int)a->pathId, (int)a->startDirection,
+			(int)a->nextDirection, (int)a->endDirection, (int)a->stepX, (int)a->stepY, (int)a->poly, (int)a->flag, (int)a->start, (int)a->freeze);
