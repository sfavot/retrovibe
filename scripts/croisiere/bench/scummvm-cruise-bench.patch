+++ b/backends/events/sdl/bench.cpp
@@ -0,0 +1,257 @@
+/*
+ * Banc d'essai local (hors dépôt) : pilote ScummVM sans fenêtre à partir d'un scénario texte et écrit des captures
+ * de l'écran du jeu (surface 8 bits + palette) au format PPM.
+ *
+ * BENCH_SCRIPT=fichier  BENCH_OUT=dossier
+ * Une commande par ligne (# = commentaire), exécutées dans l'ordre, chaque attente comptée depuis la fin de la précédente :
+ *   wait MS | move X Y | click X Y | rclick X Y | key NOM (ESC, RETURN, SPACE, F1..F10, ou un caractère)
+ *   shot NOM | burst PERIODE_MS NOMBRE PREFIXE (captures périodiques en tâche de fond) | console COMMANDE...
+ *   log TEXTE | quit
+ */
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+#include "common/scummsys.h"
+#include "common/events.h"
+#include "common/system.h"
+#include "common/array.h"
+#include "common/str.h"
+#include "common/keyboard.h"
+#include "graphics/surface.h"
+#include "graphics/paletteman.h"
+#include "engines/engine.h"
+#include "gui/debugger.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace Bench {
+
+struct Cmd {
+	Common::String op;
+	Common::Array<Common::String> args;
+	Common::String rest;
+};
+
+struct Pending {
+	uint32 at;
+	Common::Event ev;
+};
+
+static bool inited = false;
+static bool active = false;
+static bool realMouse = false;
+static Common::Array<Cmd> cmds;
+static uint pc = 0;
+static uint32 t0 = 0;
+static uint32 readyAt = 0;
+static Common::String outDir;
+static Common::Array<Pending> pending;
+static uint32 burstPeriod = 0, burstNext = 0;
+static int burstLeft = 0, burstIndex = 0;
+static Common::String burstPrefix;
+
+static uint32 now() { return g_system->getMillis() - t0; }
+
+static void init() {
+	inited = true;
+	const char *script = getenv("BENCH_SCRIPT");
+	const char *out = getenv("BENCH_OUT");
+	if (!script || !out)
+		return;
+	outDir = out;
+	FILE *f = fopen(script, "r");
+	if (!f) {
+		fprintf(stderr, "bench: cannot open %s\n", script);
+		return;
+	}
+	char line[1024];
+	while (fgets(line, sizeof(line), f)) {
+		Common::String s(line);
+		s.trim();
+		if (s.empty() || s[0] == '#')
+			continue;
+		Cmd c;
+		const char *p = s.c_str();
+		Common::String tok;
+		bool first = true;
+		const char *restStart = nullptr;
+		while (*p) {
+			while (*p == ' ' || *p == '\t') p++;
+			if (!*p) break;
+			const char *start = p;
+			while (*p && *p != ' ' && *p != '\t') p++;
+			Common::String w(start, p);
+			if (first) {
+				c.op = w;
+				first = false;
+				const char *q = p;
+				while (*q == ' ' || *q == '\t') q++;
+				restStart = q;
+			} else {
+				c.args.push_back(w);
+			}
+		}
+		if (restStart) c.rest = restStart;
+		cmds.push_back(c);
+	}
+	fclose(f);
+	active = true;
+	t0 = g_system->getMillis();
+	fprintf(stderr, "bench: %d commands\n", (int)cmds.size());
+}
+
+static void shot(const Common::String &name) {
+	Graphics::Surface *s = g_system->lockScreen();
+	if (!s) return;
+	byte pal[256 * 3];
+	memset(pal, 0, sizeof(pal));
+	g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+	Common::String path = outDir + "/" + name + ".ppm";
+	FILE *f = fopen(path.c_str(), "wb");
+	if (f) {
+		fprintf(f, "P6\n%d %d\n255\n", s->w, s->h);
+		for (int y = 0; y < s->h; y++) {
+			const byte *row = (const byte *)s->getBasePtr(0, y);
+			for (int x = 0; x < s->w; x++) {
+				const byte *c = pal + row[x] * 3;
+				fwrite(c, 1, 3, f);
+			}
+		}
+		fclose(f);
+	}
+	// Indices bruts + palette : <nom>.idx (w*h octets) et <nom>.pal (768 octets)
+	Common::String ip = outDir + "/" + name + ".idx";
+	f = fopen(ip.c_str(), "wb");
+	if (f) {
+		for (int y = 0; y < s->h; y++)
+			fwrite(s->getBasePtr(0, y), 1, s->w, f);
+		fclose(f);
+	}
+	Common::String pp = outDir + "/" + name + ".pal";
+	f = fopen(pp.c_str(), "wb");
+	if (f) {
+		fwrite(pal, 1, sizeof(pal), f);
+		fclose(f);
+	}
+	g_system->unlockScreen();
+	fprintf(stderr, "bench: t=%u shot %s\n", now(), name.c_str());
+}
+
+static void queueMouse(Common::EventType type, int x, int y, uint32 at) {
+	Pending p;
+	p.at = at;
+	p.ev.type = type;
+	p.ev.mouse = Common::Point(x, y);
+	pending.push_back(p);
+}
+
+static bool parseKey(const Common::String &k, Common::KeyState &ks) {
+	if (k.equalsIgnoreCase("ESC")) { ks = Common::KeyState(Common::KEYCODE_ESCAPE, Common::ASCII_ESCAPE); return true; }
+	if (k.equalsIgnoreCase("RETURN")) { ks = Common::KeyState(Common::KEYCODE_RETURN, Common::ASCII_RETURN); return true; }
+	if (k.equalsIgnoreCase("SPACE")) { ks = Common::KeyState(Common::KEYCODE_SPACE, ' '); return true; }
+	if (k.equalsIgnoreCase("UP")) { ks = Common::KeyState(Common::KEYCODE_UP, 0); return true; }
+	if (k.equalsIgnoreCase("DOWN")) { ks = Common::KeyState(Common::KEYCODE_DOWN, 0); return true; }
+	if (k.equalsIgnoreCase("LEFT")) { ks = Common::KeyState(Common::KEYCODE_LEFT, 0); return true; }
+	if (k.equalsIgnoreCase("RIGHT")) { ks = Common::KeyState(Common::KEYCODE_RIGHT, 0); return true; }
+	if (k.size() == 3 && (k[0] == 'K' || k[0] == 'k') && (k[1] == 'P' || k[1] == 'p') && k[2] >= '1' && k[2] <= '9') {
+		ks = Common::KeyState((Common::KeyCode)(Common::KEYCODE_KP0 + (k[2] - '0')), 0);
+		return true;
+	}
+	if ((k[0] == 'F' || k[0] == 'f') && k.size() >= 2 && k.size() <= 3) {
+		int n = atoi(k.c_str() + 1);
+		if (n >= 1 && n <= 12) {
+			ks = Common::KeyState((Common::KeyCode)(Common::KEYCODE_F1 + n - 1), (uint16)(Common::ASCII_F1 + n - 1));
+			return true;
+		}
+	}
+	if (k.size() == 1) {
+		char c = k[0];
+		char lc = (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c;
+		ks = Common::KeyState((Common::KeyCode)lc, (uint16)c);
+		return true;
+	}
+	return false;
+}
+
+static void step() {
+	uint32 t = now();
+	if (burstLeft > 0 && t >= burstNext) {
+		shot(Common::String::format("%s%04d", burstPrefix.c_str(), burstIndex++));
+		burstLeft--;
+		burstNext += burstPeriod;
+		if (burstNext < t) burstNext = t + burstPeriod;
+	}
+	while (pc < cmds.size() && t >= readyAt && pending.empty()) {
+		const Cmd &c = cmds[pc++];
+		fprintf(stderr, "bench: t=%u %s %s\n", t, c.op.c_str(), c.rest.c_str());
+		if (c.op == "wait") {
+			readyAt = t + atoi(c.args[0].c_str());
+		} else if (c.op == "move") {
+			queueMouse(Common::EVENT_MOUSEMOVE, atoi(c.args[0].c_str()), atoi(c.args[1].c_str()), t);
+			readyAt = t + 20;
+		} else if (c.op == "click" || c.op == "rclick") {
+			int x = atoi(c.args[0].c_str()), y = atoi(c.args[1].c_str());
+			bool r = c.op == "rclick";
+			queueMouse(Common::EVENT_MOUSEMOVE, x, y, t);
+			queueMouse(r ? Common::EVENT_RBUTTONDOWN : Common::EVENT_LBUTTONDOWN, x, y, t + 60);
+			queueMouse(r ? Common::EVENT_RBUTTONUP : Common::EVENT_LBUTTONUP, x, y, t + 160);
+			readyAt = t + 200;
+		} else if (c.op == "key") {
+			Common::KeyState ks;
+			if (parseKey(c.args[0], ks)) {
+				Pending d; d.at = t; d.ev.type = Common::EVENT_KEYDOWN; d.ev.kbd = ks;
+				Pending u; u.at = t + 80; u.ev.type = Common::EVENT_KEYUP; u.ev.kbd = ks;
+				pending.push_back(d);
+				pending.push_back(u);
+			}
+			readyAt = t + 120;
+		} else if (c.op == "wheel") {
+			Pending w; w.at = t; w.ev.type = (c.args[0] == "up") ? Common::EVENT_WHEELUP : Common::EVENT_WHEELDOWN;
+			pending.push_back(w);
+			readyAt = t + 60;
+		} else if (c.op == "act") {
+			// Action propre au moteur (`EVENT_CUSTOM_ENGINE_ACTION_START`, numéro de l'énumération du moteur : Lure 14 suivant, 15 précédent, 16 choisir).
+			Pending a; a.at = t; a.ev.type = Common::EVENT_CUSTOM_ENGINE_ACTION_START; a.ev.customType = (Common::CustomEventType)atoi(c.args[0].c_str());
+			pending.push_back(a);
+			readyAt = t + 60;
+		} else if (c.op == "realmouse") {
+			// Le pointeur est celui du banc seul : les mouvements fictifs que SDL renvoie après `warpMouse` (fenêtre factice) sont ignorés, ce qui
+			// rend utilisable le menu surgissant de Lure (mode souris : l'entrée suit la position du pointeur). Par défaut, ils sont gardés (anciens scénarios).
+			realMouse = true;
+		} else if (c.op == "shot") {
+			shot(c.args[0]);
+		} else if (c.op == "burst") {
+			burstPeriod = atoi(c.args[0].c_str());
+			burstLeft = atoi(c.args[1].c_str());
+			burstPrefix = c.args[2];
+			burstIndex = 0;
+			burstNext = t;
+		} else if (c.op == "console") {
+			GUI::Debugger *d = g_engine ? g_engine->getDebugger() : nullptr;
+			if (d) d->parseCommand(c.rest.c_str());
+			else fprintf(stderr, "bench: no debugger\n");
+		} else if (c.op == "log") {
+			// already printed
+		} else if (c.op == "quit") {
+			Pending q; q.at = t; q.ev.type = Common::EVENT_QUIT;
+			pending.push_back(q);
+		}
+	}
+}
+
+bool pollEvent(Common::Event &event) {
+	if (!inited) init();
+	if (!active) return false;
+	step();
+	if (!pending.empty() && now() >= pending[0].at) {
+		event = pending[0].ev;
+		pending.remove_at(0);
+		return true;
+	}
+	return false;
+}
+
+bool isActive() {
+	return active && realMouse;
+}
+
+} // End of namespace Bench
