+/* Banc d'essai local (hors depot) : traces du moteur gob (Ween), toutes sur stderr, inactives par defaut.
+ *
+ * Une « image » n est un point ou le script rend la main au temps : debut de Util::waitEndFrame (cadence des animations),
+ * Inter::handleBusyWait (chaque o1_keyFunc, y compris l'attente active de l'introduction), VideoPlayer::waitEndFrame (image d'une
+ * video IMD), chaque tour des boucles d'attente de Hotspots::evaluate (zones actives, menus), de Util::getKey / waitMouseUp /
+ * waitMouseDown / waitMouseRelease et de Sound::blasterWaitEndPlay (o1_waitEndPlay, un tour = longDelay(200)). Le compte ne
+ * depend que du deroulement du script (et, pour les boucles d'attente, du temps de jeu : deterministe avec le temps virtuel),
+ * pas du temps reel. Au point d'image n, l'ecran montre deja l'image n (blitInvalidated a eu lieu juste avant).
+ *
+ *   GOB_TRACE=1        `TT n nom` (TOT charge par Game::playTot, loadTot comme totSub), `GB n tot pos id nom` (o2_goblinFunc),
+ *                      `PS n tot offset` (protection sautee), `WK n tot pos v59` (rustine VAR(59) de l'introduction)
+ *   GOB_TRACE=2        + `OP n tot pos opcode` pour chaque instruction (pos = octet de l'opcode, nom ScummVM)
+ *   GOB_TRACE=3        + `DL n t ms tot pos` pour chaque Util::delay (t = horloge avant l'attente ; waitRetrace, longDelay, waitEndFrame...)
+ *   GOB_VARHASH=1      `VH n h` a chaque image : FNV-1a 32 bits des octets des variables courantes (_inter->_variables, ordre memoire)
+ *   GOB_DUMP=a-b       `DV n v0 v1 ...` (toutes les variables 32 bits, non signees) pour les images a a b
+ *   GOB_SHOT_FRAMES=n1,n2,... + GOB_SHOT_DIR=dossier : fr-NNNNN.idx (ecran 320x200, indices bruts, sans le curseur) et fr-NNNNN.pal
+ *   GOB_INPUT=fichier  entrees par image, appliquees au point d'image n (lues par le prochain processInput) :
+ *                      `n m x y` (deplacement), `n c x y` (clic gauche : appui en n, relache en n+1), `n d x y` / `n u x y` (appui / relache
+ *                      gauche), `n r x y` (clic droit), `n k TOUCHE` (ESC, RETURN, SPACE, UP, DOWN, LEFT, RIGHT, F1-F12, ou un caractere ;
+ *                      appui en n, relache en n+1), `n q` (quitter)
+ *   GOB_STOP_FRAME=n   quitte apres l'image n
+ */
+
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+
+#include "common/scummsys.h"
+#include "common/system.h"
+#include "common/events.h"
+#include "common/array.h"
+#include "common/keyboard.h"
+#include "common/str.h"
+#include "graphics/surface.h"
+#include "graphics/paletteman.h"
+
+#include "gob/benchtrace.h"
+#include "gob/gob.h"
+#include "gob/inter.h"
+#include "gob/variables.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace Gob {
+namespace BenchTrace {
+
+static uint32 frameNo = 0;
+
+int level() {
+	static int l = -1;
+	if (l < 0) {
+		const char *e = getenv("GOB_TRACE");
+		l = e ? atoi(e) : 0;
+	}
+	return l;
+}
+
+uint32 frame() {
+	return frameNo;
+}
+
+struct Input {
+	uint32 n;
+	Common::Event ev;
+};
+
+static Common::Array<Input> inputs;
+static uint inputPos = 0;
+
+static bool parseKey(const char *k, Common::KeyState &ks) {
+	if (!strcasecmp(k, "ESC")) { ks = Common::KeyState(Common::KEYCODE_ESCAPE, Common::ASCII_ESCAPE); return true; }
+	if (!strcasecmp(k, "RETURN")) { ks = Common::KeyState(Common::KEYCODE_RETURN, Common::ASCII_RETURN); return true; }
+	if (!strcasecmp(k, "SPACE")) { ks = Common::KeyState(Common::KEYCODE_SPACE, ' '); return true; }
+	if (!strcasecmp(k, "UP")) { ks = Common::KeyState(Common::KEYCODE_UP, 0); return true; }
+	if (!strcasecmp(k, "DOWN")) { ks = Common::KeyState(Common::KEYCODE_DOWN, 0); return true; }
+	if (!strcasecmp(k, "LEFT")) { ks = Common::KeyState(Common::KEYCODE_LEFT, 0); return true; }
+	if (!strcasecmp(k, "RIGHT")) { ks = Common::KeyState(Common::KEYCODE_RIGHT, 0); return true; }
+	if ((k[0] == 'F' || k[0] == 'f') && k[1] >= '1' && k[1] <= '9') {
+		int n = atoi(k + 1);
+		if (n >= 1 && n <= 12) {
+			ks = Common::KeyState((Common::KeyCode)(Common::KEYCODE_F1 + n - 1), (uint16)(Common::ASCII_F1 + n - 1));
+			return true;
+		}
+	}
+	if (k[0] && !k[1]) {
+		char c = k[0];
+		char lc = (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c;
+		ks = Common::KeyState((Common::KeyCode)lc, (uint16)c);
+		return true;
+	}
+	return false;
+}
+
+static void addMouse(uint32 n, Common::EventType t, int x, int y) {
+	Input in;
+	in.n = n;
+	in.ev.type = t;
+	in.ev.mouse = Common::Point(x, y);
+	inputs.push_back(in);
+}
+
+static void loadInputs() {
+	static bool loaded = false;
+	if (loaded)
+		return;
+	loaded = true;
+	const char *path = getenv("GOB_INPUT");
+	if (!path)
+		return;
+	FILE *f = fopen(path, "r");
+	if (!f) {
+		fprintf(stderr, "gob bench: cannot open %s\n", path);
+		return;
+	}
+	char line[256];
+	while (fgets(line, sizeof(line), f)) {
+		unsigned n = 0;
+		char op[8] = {0}, a[64] = {0};
+		int x = 0, y = 0;
+		if (line[0] == '#' || sscanf(line, "%u %7s", &n, op) < 2)
+			continue;
+		if (op[0] == 'k') {
+			Common::KeyState ks;
+			if (sscanf(line, "%u %7s %63s", &n, op, a) == 3 && parseKey(a, ks)) {
+				Input d; d.n = n; d.ev.type = Common::EVENT_KEYDOWN; d.ev.kbd = ks;
+				Input u; u.n = n + 1; u.ev.type = Common::EVENT_KEYUP; u.ev.kbd = ks;
+				inputs.push_back(d);
+				inputs.push_back(u);
+			}
+		} else if (op[0] == 'q') {
+			Input q; q.n = n; q.ev.type = Common::EVENT_QUIT;
+			inputs.push_back(q);
+		} else if (sscanf(line, "%u %7s %d %d", &n, op, &x, &y) == 4) {
+			addMouse(n, Common::EVENT_MOUSEMOVE, x, y);
+			if (op[0] == 'c' || op[0] == 'd')
+				addMouse(n, Common::EVENT_LBUTTONDOWN, x, y);
+			if (op[0] == 'c')
+				addMouse(n + 1, Common::EVENT_LBUTTONUP, x, y);
+			if (op[0] == 'u')
+				addMouse(n, Common::EVENT_LBUTTONUP, x, y);
+			if (op[0] == 'r') {
+				addMouse(n, Common::EVENT_RBUTTONDOWN, x, y);
+				addMouse(n + 1, Common::EVENT_RBUTTONUP, x, y);
+			}
+		}
+	}
+	fclose(f);
+	// Tri stable par image (les relaches en n+1 sont ajoutees apres les lignes de l'image n).
+	for (uint i = 1; i < inputs.size(); i++)
+		for (uint j = i; j > 0 && inputs[j - 1].n > inputs[j].n; j--) {
+			Input t = inputs[j - 1];
+			inputs[j - 1] = inputs[j];
+			inputs[j] = t;
+		}
+	fprintf(stderr, "gob bench: %u inputs\n", (unsigned)inputs.size());
+}
+
+static bool listHas(const char *list, uint32 n) {
+	for (const char *p = list; *p;) {
+		if ((uint32)atoi(p) == n)
+			return true;
+		while (*p && *p != ',')
+			p++;
+		if (*p == ',')
+			p++;
+	}
+	return false;
+}
+
+static void shot(uint32 n) {
+	static const char *list = getenv("GOB_SHOT_FRAMES");
+	static const char *dir = getenv("GOB_SHOT_DIR");
+	if (!list || !dir || !listHas(list, n))
+		return;
+	Graphics::Surface *s = g_system->lockScreen();
+	if (!s)
+		return;
+	byte pal[256 * 3];
+	memset(pal, 0, sizeof(pal));
+	g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+	char path[1024];
+	snprintf(path, sizeof(path), "%s/fr-%05u.idx", dir, n);
+	FILE *f = fopen(path, "wb");
+	if (f) {
+		for (int y = 0; y < s->h; y++)
+			fwrite(s->getBasePtr(0, y), 1, s->w * s->format.bytesPerPixel, f);
+		fclose(f);
+	}
+	snprintf(path, sizeof(path), "%s/fr-%05u.pal", dir, n);
+	f = fopen(path, "wb");
+	if (f) {
+		fwrite(pal, 1, sizeof(pal), f);
+		fclose(f);
+	}
+	g_system->unlockScreen();
+}
+
+void onFrame(GobEngine *vm) {
+	frameNo++;
+	const uint32 n = frameNo;
+
+	shot(n);
+
+	Variables *vars = (vm && vm->_inter) ? vm->_inter->_variables : nullptr;
+	static const char *vh = getenv("GOB_VARHASH");
+	if (vh && vars) {
+		const uint8 *p = vars->getAddressOff8(0);
+		uint32 size = vars->getSize();
+		uint32 h = 2166136261u;
+		for (uint32 i = 0; i < size; i++) {
+			h ^= p[i];
+			h *= 16777619u;
+		}
+		fprintf(stderr, "VH %u %u\n", n, h);
+	}
+	static const char *dump = getenv("GOB_DUMP");
+	if (dump && vars) {
+		unsigned a = 0, b = 0;
+		if (sscanf(dump, "%u-%u", &a, &b) == 2 && n >= a && n <= b) {
+			fprintf(stderr, "DV %u", n);
+			for (uint32 i = 0; i + 4 <= vars->getSize(); i += 4)
+				fprintf(stderr, " %u", vars->readOff32(i));
+			fprintf(stderr, "\n");
+		}
+	}
+
+	loadInputs();
+	Common::EventManager *em = g_system->getEventManager();
+	while (inputPos < inputs.size() && inputs[inputPos].n <= n) {
+		em->pushEvent(inputs[inputPos].ev);
+		inputPos++;
+	}
+
+	static const char *stop = getenv("GOB_STOP_FRAME");
+	if (stop && n == (uint32)atoi(stop)) {
+		Common::Event q;
+		q.type = Common::EVENT_QUIT;
+		em->pushEvent(q);
+	}
+}
+
+void onTot(const char *name) {
+	if (level() >= 1)
+		fprintf(stderr, "TT %u %s\n", frameNo, name);
+}
+
+void onOp(const char *tot, uint32 pos, const char *desc, int i, int j) {
+	if (level() >= 2)
+		fprintf(stderr, "OP %u %s %u %s\n", frameNo, tot, pos, (desc && *desc) ? desc : Common::String::format("op_%d_%d", i, j).c_str());
+}
+
+void onGob(const char *tot, uint32 pos, int id, const char *desc, bool known) {
+	if (level() >= 1)
+		fprintf(stderr, "GB %u %s %u %d %s\n", frameNo, tot, pos, id, known ? ((desc && *desc) ? desc : "?") : "unimplemented");
+}
+
+void note(const char *tag, const char *text) {
+	if (level() >= 1)
+		fprintf(stderr, "%s %u %s\n", tag, frameNo, text);
+}
+
+} // End of namespace BenchTrace
+} // End of namespace Gob
