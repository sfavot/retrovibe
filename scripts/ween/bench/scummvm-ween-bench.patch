+// Banc : SKY_VIRTUAL_TIME=1 : horloge virtuelle, qui n'avance que par delayMillis (sans attendre) ; les tours, fondus, sequences et attentes
+// du jeu prennent leur duree nominale sans temps reel (comme le portage, qui compte ses ticks de 20 ms).
+static bool benchVirtualTime() {
+	static int v = -1;
+	if (v < 0)
+		v = getenv("SKY_VIRTUAL_TIME") ? 1 : 0;
+	return v == 1;
+}
+static volatile uint32 benchNow = 0;
+
 uint32 OSystem_SDL::getMillis(bool skipRecord) {
-	uint32 millis = SDL_GetTicks();
+	uint32 millis = benchVirtualTime() ? benchNow : SDL_GetTicks();
 
 #ifdef ENABLE_EVENTRECORDER
 	g_eventRec.processMillis(millis, skipRecord);
@@ -886,7 +897,41 @@ uint32 OSystem_SDL::getMillis(bool skipRecord) {
