+}
+
+static int savedPos = 0;
+static char preStr[8][48];
+static bool preIsStr[8];
+
+static void renderString(const char *p, char *out) {
+	char *o = out;
+	*o++ = 'S';
+	*o++ = '"';
+	for (int i = 0; i < 40 && p[i]; i++) {
+		unsigned char c = (unsigned char)p[i];
+		if (c >= 32 && c < 127 && c != '"' && c != '\\')
+			*o++ = (char)c;
+		else
+			o += sprintf(o, "\\x%02x", c);
+	}
+	*o++ = '"';
+	*o = 0;
+}
+
+// Les chaines passees en argument sont lues AVANT l'appel (Strcpy / Strcat modifient leur destination) ; la destination de Strcpy, Strcat et Itoa
+// est notee P (pointeur) : son contenu avant l'appel n'a pas de sens.
+void nativeBegin(int opc) {
+	savedPos = positionInStack;
+	if (traceLevel < 2)
+		return;
+	bool strFn = opc >= 0 && opc < (int)ARRAYSIZE(kFuncStr) && kFuncStr[opc];
+	for (int i = 0; i < 8; i++) {
+		preIsStr[i] = false;
+		int idx = savedPos - 1 - i;
+		if (idx < 0 || !strFn)
+			continue;
+		const stackElementStruct &e = scriptStack[idx];
+		if (e.type != STACK_PTR || !e.data.ptrVar)
+			continue;
+		if ((opc == 0x6d || opc == 0x6e) && i == 1)
+			continue;
+		if (opc == 0x6f)
+			continue;
+		preIsStr[i] = true;
+		renderString((const char *)e.data.ptrVar, preStr[i]);
+	}
+}
+
+void nativeEnd(int opc, int16 result) {
+	if (traceLevel < 2)
+		return;
+	int n = savedPos - positionInStack;
+	const char *name = (opc >= 0 && opc < (int)ARRAYSIZE(kFuncNames)) ? kFuncNames[opc] : "?";
+	fprintf(stderr, "NF 0x%02x %s (", opc, name);
+	if (n < 0 || n > 16)
+		fprintf(stderr, "n=%d", n);
+	else {
+		for (int i = 0; i < n; i++) {
+			const stackElementStruct &e = scriptStack[savedPos - 1 - i];
+			if (i)
+				fputc(',', stderr);
+			if (e.type == STACK_SHORT)
+				fprintf(stderr, "%d", (int)e.data.shortVar);
+			else if (i < 8 && preIsStr[i])
+				fputs(preStr[i], stderr);
+			else
+				fputc('P', stderr);
+		}
+	}
+	fprintf(stderr, ") -> %d\n", (int)result);
+	if (opc == 0x3c && n >= 1)
+		fprintf(stderr, "RN %d %d\n", (int)scriptStack[savedPos - 1].data.shortVar, (int)result);
+}
+
+static int findOverlay(const char *name) {
+	for (int o = 1; o < 90; o++)
+		if (overlayTable[o].alreadyLoaded && overlayTable[o].ovlData && !strcmp(overlayTable[o].overlayName, name))
+			return o;
+	return 0;
+}
+
+// Contournement de la protection (CRUISE_SKIP_PROTECTION=1). Le script XX2/2 (verification de la copie, lance par LOGO/1) calcule dans la
+// memoire de SUPER (octets 8-9, mot BE) la somme de 864 mots de la table de la roue, puis appelle ProtectionFlag(-1) et compare le resultat a cette somme :
+// egal -> UserMenu(1), Inventory(1), XX2[14] = 1 et LOGO saute le quiz ; different -> XX2[14] = 0 et LOGO lance le quiz XX2/0. Une bonne reponse
+// (XX2/0 puis relation XX2/8) laisse : SUPER[4] = SUPER[6] = 1 (un par question), SUPER[8] = la somme, protectionCode = la somme. On reproduit
+// exactement cet etat quand XX2/2 lit ProtectionFlag(-1) : le jeu prend alors son chemin « deja valide ».
+void protectionCheck() {
+	if (!skipProtection || !currentScriptPtr)
+		return;
+	if (currentScriptPtr->scriptNumber != 2 || currentScriptPtr->type != scriptType_PROC ||
+	        strcmp(overlayTable[currentScriptPtr->overlayNumber].overlayName, "XX2"))
+		return;
+	int sup = findOverlay("SUPER");
+	if (!sup)
+		return;
+	uint8 *bss = overlayTable[sup].ovlData->data4Ptr;
+	WRITE_BE_UINT16(bss + 4, 1);
+	WRITE_BE_UINT16(bss + 6, 1);
+	protectionCode = (int16)READ_BE_UINT16(bss + 8);
+	if (traceLevel >= 1)
+		fprintf(stderr, "PROT skip protectionCode=%d tick=%u\n", (int)protectionCode, tick);
+}
+
+// CRUISE_PROT_CHEAT=1 (verification seulement, jamais avec le contournement) : juste avant la relation XX2/8 (bouton OK de la question), recopie la liste
+// attendue (mots BSS XX2 [16 ..], nombre = 16 - BSS[88], car le script calcule « 16 - mot » : le sommet de pile est l'operande gauche) dans la selection du joueur (BSS[92 ..], compte dans BSS[100]) : le quiz reel prend alors son
+// chemin « bonne reponse » (XX2/0 offset 923) sans passer par l'interface des symboles.
+void beforeSlice(char list, scriptInstanceStruct *ptr) {
+	static int cheat = -1;
+	if (cheat < 0)
+		cheat = getenv("CRUISE_PROT_CHEAT") ? 1 : 0;
+	if (!cheat || list != 'R' || ptr->scriptNumber != 8 || strcmp(overlayTable[ptr->overlayNumber].overlayName, "XX2"))
+		return;
+	uint8 *bss = overlayTable[ptr->overlayNumber].ovlData->data4Ptr;
+	int n = 16 - (int16)READ_BE_UINT16(bss + 88);
+	if (ptr->scriptOffset != 0 || n < 0 || n > 4)
+		return;
+	for (int i = 0; i < 4; i++)
+		WRITE_BE_UINT16(bss + 92 + i * 2, i < n ? READ_BE_UINT16(bss + 16 + i * 2) : 0xFFFF);
+	WRITE_BE_UINT16(bss + 100, n);
+	fprintf(stderr, "PROT cheat n=%d tick=%u\n", n, tick);
+}
+
+} // End of namespace Bench
+
+} // End of namespace Cruise
