+			while (*p && *p != ',')
+				p++;
+			if (*p == ',')
+				p++;
+		}
+	}
+	e = getenv("CRUISE_DUMPVARS");
+	if (e)
+		sscanf(e, "%u-%u", &dumpA, &dumpB);
+	e = getenv("CRUISE_INPUT");
+	if (e) {
+		FILE *f = fopen(e, "r");
+		if (!f) {
+			fprintf(stderr, "bench: cannot open %s\n", e);
+		} else {
+			useInputs = true;
+			char line[256];
+			while (fgets(line, sizeof(line), f)) {
+				InRow r;
+				unsigned n;
+				if (line[0] == '#')
+					continue;
+				if (sscanf(line, "%u %d %d %d", &n, &r.x, &r.y, &r.b) == 4) {
+					r.n = n;
+					inputs.push_back(r);
+				}
+			}
+			fclose(f);
+			fprintf(stderr, "bench: %u inputs\n", inputs.size());
+		}
+	}
+	e = getenv("CRUISE_KEYS");
+	if (e) {
+		FILE *f = fopen(e, "r");
+		if (f) {
+			useInputs = true;
+			char line[256];
+			while (fgets(line, sizeof(line), f)) {
+				unsigned n;
+				char k[64];
+				if (line[0] != '#' && sscanf(line, "%u %63s", &n, k) == 2) {
+					KeyRow r;
+					r.n = n;
+					r.key = k;
+					keys.push_back(r);
+				}
+			}
+			fclose(f);
+		}
+	}
+}
+
+bool inputsActive() {
+	return useInputs;
+}
+
+static void setButton(int bit, bool down) {
+	if (down) {
+		currentMouseButton |= bit;
+		if (bit != CRS_MB_MIDDLE)
+			_vm->_mouseButtonDown = true;
+	} else {
+		currentMouseButton &= ~bit;
+		if (bit != CRS_MB_MIDDLE)
+			endpause = true;
+	}
+}
+
+// Entrees : la ligne "n x y b" est un niveau valable des le tick n ; on la rejoue comme les evenements ScummVM
+// (mouvement -> position ; bit de bouton qui change -> mise a 1 / 0 de ce bit seulement), si bien que les
+// remises a zero faites par le moteur (userDelay, isUserWait...) restent effectives jusqu'au changement suivant.
+static void applyInputs() {
+	if (!useInputs)
+		return;
+	bool have = false;
+	InRow cur = { 0, prevX, prevY, prevB };
+	while (inPos < inputs.size() && inputs[inPos].n <= tick) {
+		cur = inputs[inPos++];
+		have = true;
+	}
+	if (have) {
+		if (cur.x != prevX || cur.y != prevY) {
+			currentMouseX = cur.x;
+			currentMouseY = cur.y;
+		}
+		int diff = cur.b ^ prevB;
+		const int bits[3] = { CRS_MB_LEFT, CRS_MB_RIGHT, CRS_MB_MIDDLE };
+		for (int i = 0; i < 3; i++)
+			if (diff & bits[i])
+				setButton(bits[i], (cur.b & bits[i]) != 0);
+		prevX = cur.x;
+		prevY = cur.y;
+		prevB = cur.b;
+	}
+	if (escRelease && tick > escReleaseTick) {
+		currentMouseButton &= ~CRS_MB_MIDDLE;
+		escRelease = false;
+	}
+	while (keyPos < keys.size() && keys[keyPos].n <= tick) {
+		const Common::String &k = keys[keyPos++].key;
+		if (k.equalsIgnoreCase("ESC")) {
+			action = kActionEscape;
+			currentMouseButton |= CRS_MB_MIDDLE;
+			escRelease = true;
+			escReleaseTick = tick;
+		} else if (k.equalsIgnoreCase("SPACE"))
+			action = kActionEndUserWaiting;
+		else if (k.equalsIgnoreCase("F10"))
+			action = kActionPlayerMenu;
+		else if (k.equalsIgnoreCase("P"))
+			action = kActionPause;
+		else if (k.equalsIgnoreCase("X"))
+			action = kActionExit;
+		else if (k.equalsIgnoreCase("I"))
+			action = kActionInventory;
+		else if (k.equalsIgnoreCase("PLUS"))
+			action = kActionIncreaseGameSpeed;
+		else if (k.equalsIgnoreCase("MINUS"))
+			action = kActionDecreaseGameSpeed;
+		endpause = true;
+	}
+}
+
+void frameBegin() {
+	init();
+	tick++;
+	applyInputs();
+}
+
+void modalTick(const char *where) {
+	init();
