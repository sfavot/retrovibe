+void frameInputs(int mx, int my, int mb) {
+	if (traceLevel < 1)
+		return;
+	fprintf(stderr, "FR %u %d %d %d %d %d %d %d %d %d %d %d\n", tick, mx, my, mb, (int)userEnabled, (int)userWait, (int)autoTrack,
+		(int)currentActiveMenu, (int)dialogueEnabled, linkedRelation ? 1 : 0, _vm->gameSpeed(), (int)userDelay);
+}
+
+static void writeShot(uint32 n) {
+	byte pal[768];
+	for (int i = 0; i < 256; i++) {
+		pal[i * 3] = lpalette[i].R;
+		pal[i * 3 + 1] = lpalette[i].G;
+		pal[i * 3 + 2] = lpalette[i].B;
+	}
+	Common::String base = Common::String::format("%s/fr-%04u", shotDir.c_str(), n);
+	FILE *f = fopen((base + ".idx").c_str(), "wb");
+	if (f) {
+		fwrite(globalScreen, 1, 64000, f);
+		fclose(f);
+	}
+	f = fopen((base + ".pal").c_str(), "wb");
+	if (f) {
+		fwrite(pal, 1, 768, f);
+		fclose(f);
+	}
+}
+
+// CRUISE_DUMP_OVL=dossier : a l'arret, ecrit les scripts (apres edition de liens) des overlays charges : NOM.pN.bin / NOM.rN.bin (octets du bloc
+// de donnees) et NOM.idx (en-tetes : tailles, offsets), pour le desassemblage hors ligne.
+static void dumpOverlays() {
+	const char *dir = getenv("CRUISE_DUMP_OVL");
+	if (!dir)
+		return;
+	for (int o = 1; o < 90; o++) {
+		if (!overlayTable[o].alreadyLoaded || !overlayTable[o].ovlData)
+			continue;
+		ovlDataStruct *d = overlayTable[o].ovlData;
+		for (int kind = 0; kind < 2; kind++) {
+			ovlData3Struct *arr = kind ? d->ptr1 : d->arrayProc;
+			int num = kind ? d->numRel : d->numProc;
+			for (int i = 0; i < num; i++) {
+				if (!arr[i].dataPtr)
+					continue;
+				Common::String base = Common::String::format("%s/%s.%c%d", dir, overlayTable[o].overlayName, kind ? 'r' : 'p', i);
+				FILE *f = fopen((base + ".bin").c_str(), "wb");
+				if (f) {
+					fwrite(arr[i].dataPtr, 1, arr[i].sizeOfData, f);
+					fclose(f);
+				}
+				f = fopen((base + ".txt").c_str(), "w");
+				if (f) {
+					fprintf(f, "size=%d sub3=%d import=%d importName=%d sub2=%d sub5=%d sysKey=%d var12=%d numReloc=%d sub2Size=%d\n", arr[i].sizeOfData, arr[i].offsetToSubData3,
+						arr[i].offsetToImportData, arr[i].offsetToImportName, arr[i].offsetToSubData2, arr[i].offsetToSubData5, arr[i].sysKey, arr[i].var12,
+						arr[i].numRelocGlob, arr[i].subData2Size);
+					fclose(f);
+				}
+			}
+		}
+	}
+}
+
+void frameEnd(bool &quit) {
+	if (varHash) {
+		uint32 h = 2166136261u;
+		for (int i = 0; i < 2000; i++)
+			for (int k = 0; k < 2; k++) {
+				h ^= ((uint16)globalVars[i] >> (8 * k)) & 0xFF;
+				h *= 16777619u;
+			}
+		fprintf(stderr, "VH %u %u\n", tick, h);
+		byte pal[768];
+		for (int i = 0; i < 256; i++) {
+			pal[i * 3] = lpalette[i].R;
+			pal[i * 3 + 1] = lpalette[i].G;
+			pal[i * 3 + 2] = lpalette[i].B;
+		}
+		fprintf(stderr, "SC %u %08x %08x\n", tick, crc32(globalScreen, 64000), crc32(pal, 768));
+	}
+	if (tick >= dumpA && tick <= dumpB) {
+		fprintf(stderr, "DV %u", tick);
+		for (int i = 0; i < 2000; i++)
+			if (globalVars[i])
+				fprintf(stderr, " %d:%d", i, (int)globalVars[i]);
+		fprintf(stderr, "\n");
+		fprintf(stderr, "PC %u %d\n", tick, (int)protectionCode);
+		for (int o = 1; o < 90; o++) {
+			if (!overlayTable[o].alreadyLoaded || !overlayTable[o].ovlData || !overlayTable[o].ovlData->data4Ptr)
+				continue;
+			uint32 h = 2166136261u;
+			for (int i = 0; i < overlayTable[o].ovlData->sizeOfData4; i++) {
+				h ^= overlayTable[o].ovlData->data4Ptr[i];
+				h *= 16777619u;
+			}
+			fprintf(stderr, "BH %u %s %u\n", tick, overlayTable[o].overlayName, h);
+			const char *dn = getenv("CRUISE_DUMPBSS");	// nom d'overlay : mots BE non nuls de son BSS (`BS n nom off:val ...`)
+			if (dn && !strcmp(dn, overlayTable[o].overlayName)) {
+				fprintf(stderr, "BS %u %s", tick, dn);
+				for (int i = 0; i + 1 < overlayTable[o].ovlData->sizeOfData4; i += 2) {
+					int v = (int16)READ_BE_UINT16(overlayTable[o].ovlData->data4Ptr + i);
+					if (v)
+						fprintf(stderr, " %d:%d", i, v);
+				}
+				fprintf(stderr, "\n");
+			}
+		}
+	}
+	for (uint i = 0; i < shotFrames.size(); i++)
+		if (shotFrames[i] == tick)
+			writeShot(tick);
+	if (stopFrame && tick >= stopFrame) {
+		fprintf(stderr, "bench: stop after frame %u\n", tick);
+		dumpOverlays();
+		quit = true;
+	}
+}
+
