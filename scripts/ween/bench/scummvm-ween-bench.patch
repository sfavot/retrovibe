+/* Banc d'essai local (hors depot) : traces du moteur gob pour comparer Ween a un portage.
+ * Tout est inactif sans variables d'environnement GOB_* (voir benchtrace.cpp).
+ */
+
+#ifndef GOB_BENCHTRACE_H
+#define GOB_BENCHTRACE_H
+
+#include "common/scummsys.h"
+
+namespace Gob {
+
+class GobEngine;
+
+namespace BenchTrace {
+
+/** GOB_TRACE (0 sans la variable). */
+int level();
+/** Numero de la derniere image (0 avant la premiere). */
+uint32 frame();
+/** Point d'image : waitEndFrame, keyFunc (attente active), image d'une video, tour d'attente des zones actives. */
+void onFrame(GobEngine *vm);
+/** `TT n nom` : chargement d'un TOT (Game::playTot). */
+void onTot(const char *name);
+/** `OP n tot pos opcode` (niveau 2) : instruction de script (pos = octet de l'opcode). */
+void onOp(const char *tot, uint32 pos, const char *desc, int i, int j);
+/** `GB n tot pos id nom` : fonction gobelin (o2_goblinFunc), implementee ou non. */
+void onGob(const char *tot, uint32 pos, int id, const char *desc, bool known);
+/** Ligne libre prefixee du numero d'image (niveau >= 1). */
+void note(const char *tag, const char *text);
+
+} // End of namespace BenchTrace
+
+} // End of namespace Gob
+
+#endif
