+	e = getenv("CRUISE_STOP_FRAME");
+	stopFrame = e ? (uint32)atoi(e) : 0;
+	e = getenv("CRUISE_SHOT_DIR");
+	shotDir = e ? e : ".";
+	e = getenv("CRUISE_SHOT_FRAMES");
+	if (e) {
